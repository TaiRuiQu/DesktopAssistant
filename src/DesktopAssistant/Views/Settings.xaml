<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid.Resources>
        <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Microsoft YaHei UI"/></Style>
        <Style x:Key="Section" TargetType="StackPanel"><Setter Property="Spacing" Value="18"/><Setter Property="Margin" Value="4,16,4,24"/></Style>
        <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    </Grid.Resources>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="28,20,28,10" Spacing="6">
        <TextBlock Text="desktop assistant" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        <TextBlock Text="设置" FontSize="28" FontWeight="SemiBold"/>
        <TextBlock Text="模型接口、语音识别与唤起方式" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    </StackPanel>
    <NavigationView x:Name="SettingsNavigation" Grid.Row="1" PaneDisplayMode="Top" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" IsPaneToggleButtonVisible="False">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="模型接口" Tag="0"/>
            <NavigationViewItem Content="语音识别" Tag="1"/>
            <NavigationViewItem Content="唤起与历史" Tag="2"/>
            <NavigationViewItem Content="高级设置" Tag="3"/>
            <NavigationViewItem Content="语音合成" Tag="4"/>
        </NavigationView.MenuItems>
        <ScrollViewer x:Name="SettingsScroll" Padding="24,0,24,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsTabStop="False">
            <Grid>
                <StackPanel x:Name="ModelPage" Style="{StaticResource Section}">
                    <TextBlock Text="回答接口" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="截图、问题、转写文字和所选历史发送到此接口；语音识别接口在「语音识别」中单独配置。" Style="{StaticResource Hint}"/>
                    <TextBox x:Name="BaseUrl" Header="回答 API 根地址（Base URL）" PlaceholderText="https://api.deepseek.com" MaxLength="2048"/>
                    <TextBlock Text="填写 API 根地址并保留所需的 /v1。远程使用 HTTPS，本机服务可使用 HTTP。" Style="{StaticResource Hint}"/>
                    <PasswordBox x:Name="ApiKey" Header="回答 API Key（本机加密保存）" PasswordRevealMode="Peek" MaxLength="2048"/>
                    <TextBox x:Name="AnswerModel" Header="回答模型"/>
                    <ComboBox x:Name="ApiMode" Header="接口格式" HorizontalAlignment="Stretch"/>
                    <ToggleSwitch x:Name="SendScreenshots" Header="发送屏幕截图给回答模型" OnContent="模型需要支持图片输入" OffContent="仅发送文字与转写内容"/>
                    <TextBlock Text="使用只接受文字的模型时关闭此项，语音识别和朗读仍可使用独立接口。" Style="{StaticResource Hint}"/>
                </StackPanel>
                <StackPanel x:Name="AudioPage" Style="{StaticResource Section}" Visibility="Collapsed">
                    <TextBlock Text="语音识别接口（ASR）" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Windows 在本机识别；云端识别将录音发送到下方接口，与回答模型独立。" Style="{StaticResource Hint}"/>
                    <TextBox x:Name="SpeechBaseUrl" Header="识别 API 根地址（Base URL）" PlaceholderText="留空沿用回答接口，例如 https://openrouter.ai/api/v1" MaxLength="2048"/>
                    <PasswordBox x:Name="SpeechApiKey" Header="识别 API Key（本机加密保存）" PasswordRevealMode="Peek" MaxLength="2048"/>
                    <TextBlock Text="填写独立地址时，只使用识别密钥；地址和密钥都留空时，沿用回答接口。" Style="{StaticResource Hint}"/>
                    <ComboBox x:Name="SpeechApiMode" Header="识别接口格式" HorizontalAlignment="Stretch"/>
                    <TextBlock Text="转写模型选择 Audio Transcriptions；支持音频输入的对话模型选择 Chat Completions。OpenRouter 模型名需包含提供方前缀。" Style="{StaticResource Hint}"/>
                    <TextBlock Text="阿里百炼 Qwen-ASR 选择 DashScope Qwen-ASR，地址填写 https://dashscope.aliyuncs.com/compatible-mode/v1，模型可填 qwen3-asr-flash；也可使用所属地域的业务空间专属域名。" Style="{StaticResource Hint}"/>
                    <ComboBox x:Name="DesktopSpeechProvider" Header="背景声音识别" HorizontalAlignment="Stretch"/>
                    <TextBox x:Name="DesktopTranscriptionModel" Header="背景声音转写模型"/>
                    <ComboBox x:Name="MicrophoneSpeechProvider" Header="语音指令识别" HorizontalAlignment="Stretch"/>
                    <TextBox x:Name="MicrophoneTranscriptionModel" Header="语音指令转写模型"/>
                    <ComboBox x:Name="SpeechLanguage" Header="Windows 本机识别语言" HorizontalAlignment="Stretch"/>
                    <TextBlock Text="需安装对应的 Windows 语音识别组件；仅安装输入法可能不够。" Style="{StaticResource Hint}"/>
                    <ToggleSwitch x:Name="WakeWordEnabled" Header="语音唤醒" OnContent="待命时聆听唤醒词" OffContent="使用双击快捷键唤起"/>
                    <TextBox x:Name="WakePhrase" Header="唤醒词" PlaceholderText="小弟小弟" MaxLength="64"/>
                    <TextBlock Text="开启后持续使用麦克风，通过 Windows 本机语音组件检测唤醒词，不上传待命声音。说出唤醒词，等提问窗打开后再说问题。设置、提问、朗读及暂停期间停止检测。需安装上方所选语言的 Windows 语音识别组件。" Style="{StaticResource Hint}"/>
                    <ToggleSwitch x:Name="DuckOtherAudio" Header="提问时自动压低其他应用音量" OnContent="录音与识别期间降至原音量的 20%" OffContent="保持其他应用音量"/>
                    <TextBlock Text="识别结束、取消或失败后恢复。期间手动更改的应用音量会保留；不改变系统总音量和麦克风音量。" Style="{StaticResource Hint}"/>
                    <ToggleSwitch x:Name="CaptureDesktopAudio" Header="保留唤起前的桌面声音" OnContent="已开启" OffContent="已关闭"/>
                    <Grid ColumnSpacing="18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <NumberBox x:Name="AudioLookbackSeconds" Header="声音回看时长（秒）" Minimum="0" Maximum="60" SpinButtonPlacementMode="Compact"/>
                        <NumberBox x:Name="SilenceSeconds" Grid.Column="1" Header="说完后等待（秒）" Minimum="0.5" Maximum="15" SmallChange="0.5" SpinButtonPlacementMode="Compact"/>
                    </Grid>
                    <TextBlock Text="默认等待 4 秒静音才提交；思考停顿较长时可调至 8–15 秒，也可点击「说完了」立即提交。开始后最多等 20 秒开口。" Style="{StaticResource Hint}"/>
                </StackPanel>
                <StackPanel x:Name="ActivationPage" Style="{StaticResource Section}" Visibility="Collapsed">
                    <TextBlock Text="双击启用键后获取所有显示器画面，并开始听你说话。" Style="{StaticResource Hint}"/>
                    <ComboBox x:Name="ActivationKey" Header="双击唤起键" HorizontalAlignment="Stretch"/>
                    <NumberBox x:Name="DoubleTapMilliseconds" Header="双击间隔上限（毫秒）" Minimum="150" Maximum="1000" SmallChange="50" SpinButtonPlacementMode="Compact"/>
                    <NumberBox x:Name="HistoryTurns" Header="携带最近多少轮对话" Minimum="0" Maximum="100" SpinButtonPlacementMode="Compact"/>
                    <TextBlock Text="一轮包含一次提问和完整回答；旧截图不会重复上传。设为 0 时不携带历史。" Style="{StaticResource Hint}"/>
                    <ToggleSwitch x:Name="SaveHistory" Header="加密保存对话记录" OnContent="下次启动后继续" OffContent="仅保留本次会话"/>
                    <ToggleSwitch x:Name="StartMinimized" Header="启动后直接收起到托盘" OnContent="仅托盘待命" OffContent="显示设置窗口"/>
                </StackPanel>
                <StackPanel x:Name="AdvancedPage" Style="{StaticResource Section}" Visibility="Collapsed">
                    <NumberBox x:Name="MaxRecordingSeconds" Header="最长提问时长（秒）" Minimum="5" Maximum="120" SmallChange="5" SpinButtonPlacementMode="Compact"/>
                    <NumberBox x:Name="ScreenshotMaxDimension" Header="单屏截图最长边（像素）" Minimum="640" Maximum="7680" SmallChange="160" SpinButtonPlacementMode="Compact"/>
                    <NumberBox x:Name="VoiceThreshold" Header="麦克风音量阈值" Minimum="0.001" Maximum="0.2" SmallChange="0.001" SpinButtonPlacementMode="Compact"/>
                    <TextBox x:Name="SystemPrompt" Header="系统提示词" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="180" MaxLength="16000" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
                <StackPanel x:Name="TtsPage" Style="{StaticResource Section}" Visibility="Collapsed">
                    <TextBlock Text="语音合成（TTS）" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="使用 DashScope Qwen-TTS 朗读回答。在回答窗口点击「朗读」开始，再次点击停止。长回答会自动分段。" Style="{StaticResource Hint}"/>
                    <TextBox x:Name="TtsBaseUrl" Header="DashScope API 根地址" PlaceholderText="https://dashscope.aliyuncs.com/api/v1" MaxLength="2048"/>
                    <TextBlock Text="北京使用 dashscope.aliyuncs.com，新加坡使用 dashscope-intl.aliyuncs.com；也支持业务空间专属域名。密钥需与接口所属地域一致。" Style="{StaticResource Hint}"/>
                    <PasswordBox x:Name="TtsApiKey" Header="TTS API Key（独立配置，本机加密保存）" PasswordRevealMode="Peek" MaxLength="2048"/>
                    <TextBox x:Name="TtsModel" Header="语音合成模型" PlaceholderText="qwen3-tts-flash"/>
                    <TextBox x:Name="TtsVoice" Header="音色" PlaceholderText="Cherry"/>
                    <TextBlock Text="音色必须是所选模型支持的名称，如 Cherry。回答文字仅在点击朗读时发送；停止朗读、收起窗口或开始新问题会中断合成与播放。" Style="{StaticResource Hint}"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </NavigationView>
    <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Padding="28,16">
        <StackPanel Spacing="12">
            <InfoBar x:Name="SettingsError" IsOpen="False" Severity="Error" Title="设置未保存" IsClosable="True"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button x:Name="CancelSettings" Content="关闭" MinWidth="88"/>
                <Button x:Name="SaveSettings" Content="保存并关闭" MinWidth="112" Style="{ThemeResource AccentButtonStyle}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Grid>

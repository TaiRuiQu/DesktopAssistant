<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent" Padding="24,12,24,16" RowSpacing="12">
    <Grid.Resources>
        <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Microsoft YaHei UI"/></Style>
        <Style x:Key="QuietButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
    </Grid.Resources>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid MinHeight="36" ColumnSpacing="12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <TextBlock Text="提问" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock x:Name="AnswerShortcut" Text="双击右 Shift" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" MaxWidth="260" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
            <Button x:Name="SettingsButton" Style="{StaticResource QuietButton}" AutomationProperties.Name="设置" ToolTipService.ToolTip="设置">
                <FontIcon Glyph="&#xE713;" FontSize="16"/>
            </Button>
            <Button x:Name="HideButton" Style="{StaticResource QuietButton}" AutomationProperties.Name="收起窗口" ToolTipService.ToolTip="收起到托盘 · Esc">
                <FontIcon Glyph="&#xE711;" FontSize="14"/>
            </Button>
        </StackPanel>
    </Grid>
    <Grid Grid.Row="1">
        <Border x:Name="QuestionSnapshot" Visibility="Collapsed" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ScrollViewer MaxHeight="96" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="SubmittedQuestion" Text="你的问题会显示在这里" TextWrapping="Wrap" FontSize="16" LineHeight="26" IsTextSelectionEnabled="True"/>
                </ScrollViewer>
                <Button x:Name="CopyQuestionButton" Grid.Column="1" VerticalAlignment="Top" Style="{StaticResource QuietButton}" AutomationProperties.Name="复制问题" ToolTipService.ToolTip="复制问题">
                    <FontIcon Glyph="&#xE8C8;" FontSize="14"/>
                </Button>
            </Grid>
        </Border>
        <TextBox x:Name="QuestionBox" FontFamily="Microsoft YaHei UI" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="32000"
                 PlaceholderText="输入问题，或点击语音开始说话" MinHeight="80" MaxHeight="132" FontSize="16" Padding="12,10"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="当前问题"/>
    </Grid>
    <Grid x:Name="QuestionToolbar" Grid.Row="2" ColumnSpacing="8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="Ctrl + Enter 发送" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <Button x:Name="CancelButton" Content="取消" Visibility="Collapsed"/>
            <Button x:Name="VoiceButton" AutomationProperties.Name="语音提问" ToolTipService.ToolTip="开始语音提问">
                <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE720;" FontSize="14"/><TextBlock Text="语音"/></StackPanel>
            </Button>
            <Button x:Name="FinishButton" Content="说完了" Visibility="Collapsed" Style="{ThemeResource AccentButtonStyle}"/>
            <Button x:Name="SendButton" Content="发送" MinWidth="72" Style="{ThemeResource AccentButtonStyle}"/>
        </StackPanel>
    </Grid>
    <Border Grid.Row="3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1" CornerRadius="8" Padding="16,12">
        <Grid RowSpacing="8">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="回答" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <ProgressRing x:Name="ActivityRing" Width="14" Height="14" IsActive="False"/>
                </StackPanel>
                <TextBlock x:Name="AnswerStatus" Grid.Column="1" Text="等待你的问题" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
            </Grid>
            <ScrollViewer x:Name="AnswerScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          HorizontalContentAlignment="Stretch" Padding="0,0,4,0">
                <RichTextBlock x:Name="AnswerBody" FontFamily="Microsoft YaHei UI" FontSize="16" LineHeight="28"
                               IsTextSelectionEnabled="True" TextWrapping="Wrap" Padding="0,0,0,8" AutomationProperties.Name="当前回答"/>
            </ScrollViewer>
        </Grid>
    </Border>
    <StackPanel Grid.Row="4" Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="4">
            <Button x:Name="CopyButton" Style="{StaticResource QuietButton}" AutomationProperties.Name="复制回答" Content="复制"/>
            <Button x:Name="SpeakButton" Style="{StaticResource QuietButton}" AutomationProperties.Name="朗读回答">
                <TextBlock x:Name="SpeakLabel" Text="朗读"/>
            </Button>
            <Button x:Name="EditQuestionButton" Style="{StaticResource QuietButton}" Content="追问" AutomationProperties.Name="继续提问"/>
        </StackPanel>
        <TextBlock x:Name="StatusLabel" Text="输入问题，或点击语音开始说话" FontSize="12"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
    </StackPanel>
</Grid>
